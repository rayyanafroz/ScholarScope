# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, add these under Project -> Settings -> Environment Variables.

# Strongly recommended. Free key from https://openalex.org/settings/api
# Without it, requests share a small anonymous daily budget per IP address,
# which on shared hosting runs out quickly.
OPENALEX_API_KEY=

# Optional. Your email address, sent to OpenAlex as ?mailto= (their "polite
# pool" convention, so they can contact you if your traffic causes problems).
OPENALEX_MAILTO=

# Optional. "true" animates result cards with GSAP (lazy-loaded, ~26 KB gzip).
# Anything else uses the built-in CSS animation. Read at build time, so
# redeploy after changing it.
NEXT_PUBLIC_ENABLE_GSAP=false
